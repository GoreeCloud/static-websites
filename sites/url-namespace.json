{
  "schema_version": "2.0",
  "repository": "GoreeCloud/static-websites",
  "canonical_origin": "https://www.goreecloud.com",
  "state": "single-retained-website",
  "website": {
    "id": "main",
    "current_public_host": "www.goreecloud.com",
    "source_path": "sites/main",
    "artifact_path": "sites/main/dist",
    "build_command": ["python", "sites/main/scripts/build_public_site.py"]
  },
  "canonical_paths": [
    {"id":"home","path":"/","source":"sites/main/index.html"},
    {"id":"platform-systems","path":"/platform-systems/","source":"sites/main/platform-systems/index.html"},
    {"id":"suite","path":"/suite/","source":"sites/main/suite/index.html"},
    {"id":"office-suite","path":"/office-suite/","source":"sites/main/office-suite/index.html"},
    {"id":"firefox","path":"/firefox/","source":"sites/main/firefox/index.html"},
    {"id":"github","path":"/github/","source":"sites/main/github/index.html"}
  ],
  "compatibility_paths": [
    {"from":"/repositories.html","to":"/github/"},
    {"from":"/privacy.html","to":"/platform-systems/"},
    {"from":"/security.html","to":"/platform-systems/"},
    {"from":"/firefox-extensions","to":"/firefox/"}
  ],
  "historical_boundary": "sites/manifest.json and former sites/<site-id> packages are migration/retirement history, not current website inventory or deployment authority."
}
